[133] = {
	id = 133,
	name = "武术教头",
	talk = "我的功夫你应该不会怀疑吧。那群徒弟嘛也算是学有所成了。唉，要不是这把老骨头，我也真想同他们一道去闯荡闯荡！",
	modelid = 1043,
},
[134] = {
	id = 134,
	name = "武术学员",
	talk = "站在这里浑身僵得像石头。师傅老说北方有蜘蛛，不让我们出去，可我只见过一些半兽人什么的，蜘蛛到底在哪里？",
	modelid = 1065,
},
[135] = {
	id = 135,
	name = "武术学员",
	talk = "我表妹在比奇开首饰店，天天站着等我。听说老有人和她搭讪，问七问八的，真不放心啊。",
	modelid = 1065,
},
[136] = {
	id = 136,
	name = "武术学员",
	talk = "披上盔甲，我还是天下最好的战士！我要去赤月峡谷找上次那个血巨人再拼一次！上次好险，辛亏师傅救我，这次我肯定成功！",
	modelid = 1065,
},
[137] = {
	id = 137,
	name = "武术学员",
	talk = "啊，又有人来了！真难为情……人家练功不习惯被人看着嘛。",
	modelid = 1065,
},
[138] = {
	id = 138,
	name = "武术学员",
	talk = "看什么看？没见过帅哥啊！你再看……你再看……在看我打你！我可会野蛮冲撞啊！",
	modelid = 1066,
},
[139] = {
