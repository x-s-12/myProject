[201] = {
	id = 201,
	name = "",
	talk = "|C:0xfc21ed&T:金币回收|\n你有多余的绑定金币吗？那可是很珍贵的东西，我这里可以拿元宝/银两和你换",
	modelid = 1125,
	funcGroup = {117},
},
[202] = {
	id = 202,
	name = "",
	talk = "|C:0xfc21ed&T:四象神兽|\n四象是指青龙、白虎、朱雀、玄武四大神兽，如果你有对应的四象丹，我就能帮你大幅提升能力。据说40级以上地图的精英和领主都藏了很多四象丹。",
	modelid = 1145,
	funcGroup = {118},
},
[203] = {
	id = 203,
	name = "",
	talk = "|C:0xfc21ed&T:东西关|\n|C:0x1be200&T:[地图难度]|中高难度\n|C:0x1be200&T:[稀有装备]|战神级、炎之战神级、星王级\n|C:0x1be200&T:[地图产出]|5-6转材料、各类道具\n|C:0x1be200&T:[进入条件]|4转\n|C:0x1be200&T:[门票消耗]|5万绑金",
	modelid = 1025,
	funcGroup = {121},
},
[204] = {
	id = 204,
	name = "",
	talk = "|C:0xfc21ed&T:冰封之境、冰封雪域|\n|C:0x1be200&T:[地图说明]|冰封之境怪物攻速超快，双防不够去了就送；\n雪域持续每秒100点伤害，怪物破防，提升了回血能力再去\n|C:0x1be200&T:[进入条件]|\n|C:0x1be200&T:冰封之境 |5转，开启狂暴之力，神魔总等级10级\n|C:0x1be200&T:冰封雪域 |5转，开启狂暴之力，神魔总等级15级\n|C:0x1be200&T:[门票消耗]|5万绑金",
