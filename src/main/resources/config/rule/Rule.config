--G-规则说明.xlsx 说明
RuleConf={
[1] = {
	id = 1,
	ruleContent = "1.背包分为药品包裹、装备包裹、材料包裹三类。药品包裹上限48格，存放药品和消耗品；装备包裹上限190格，存放装备类物品，双击装备可以穿戴；材料包裹上限190格，存放材料类物品\n\n2.捡取物品、收取邮件、领取奖励时必须|C:0xda1e00&T:在各个包裹保留足够的空格|，领取药品时通常不会判断药品包裹剩余空位，可能造成领取的药品消失\n\n3.|C:0xda1e00&T:药品包裹内物品在角色死亡时有几率爆出，红名角色死亡时全部爆出|，装备和材料包裹内物品不会爆出\n\n4.金币、绑定金币的上限为10亿，超过上限无法增加。你可以点击金币图标将其兑换为绑定金币使用\n\n5.不用的物品可通过回收商人回收，极品属性装备回收时会额外获得回收积分\n\n6.在设置-回收中可以调整一键回收的装备级别，请慎重使用。白卡会员还可以选择智能回收，当装备包裹达到100格时系统会自动进行一键回收，方便长时间挂机\n\n7.药品包裹中的药品可拖至快捷栏，通过快捷键使用，快捷键仅限QWERTY123456\n\n8.你可以使用快捷键|C:0x2eb52d&T: 9 |打开背包界面",
},
[2] = {
	id = 2,
	ruleContent = "1.绑定金币可以用于升级技能、在NPC处购买物品、升级属性等\n\n2.金币可以按照|C:0xda1e00&T:1:1的比例|兑换成绑定金币\n\n3.绑定金币需要交易，请先在【商城-绑金商城】中兑换成小金块、金条、金砖",
},
[3] = {
	id = 3,
	ruleContent = "1.元宝可以用于寄售行、私人交易、元宝商城和部分活动，银两可以用于银两商城和参加部分活动\n\n2.元宝可以按照|C:0xda1e00&T:1:1的比例|兑换成银两，银两无法再兑换回元宝，请根据需要适量兑换\n\n3.一旦兑换成银两，将无法再流转交易",
},
[4] = {
	id = 4,
	ruleContent = "1.装备包含武器、衣服、头盔、腰带、靴子、戒指、手镯、项链、勋章、魂玉、佩饰和回复玉\n\n2.在背包内双击装备可以穿戴，在本界面双击装备栏内装备可以卸下\n\n3.武器、衣服、头盔、腰带、靴子、戒指、手镯、项链|C:0xda1e00&T:在角色死亡时有几率爆出，红名角色死亡时爆率提升|，角色死亡爆出装备时该装备上的极品属性会一同消失，升星效果不会消失\n\n4.你可以使用快捷键|C:0x2eb52d&T: 0 |打开本界面",
},
[5] = {
	id = 5,
	ruleContent = "1.学习职业技能需要达到一定的等级（或转生）条件，并且可能需要消耗绑定金币和秘籍，学习技能不需要技能书\n\n2.符合学习条件、材料充足时，点击“升级”按钮即可学习或提升职业技能\n\n3.通过快捷键按钮可以为主动技能设置快捷键，快捷键仅限|C:0x2eb52d&T:QWERT123456|\n\n4.部分技能最高级别为10级\n\n5.你可以使用快捷键|C:0x2eb52d&T: - |打开本界面",
},
[6] = {
	id = 6,
	ruleContent = "1.通用技能包括回城、盟重回城、比奇回城、随机传送都是默认学习，可以直接使用，提升回城技能等级可以缩短使用CD；安全区回复技能需要达到条件后消耗材料学习提升\n\n2.使用回城技能将回到最近一次去过的主城安全区；使用盟重回城将回到盟重土城安全区；使用比奇回城将回到比奇安全区；使用随机传送会传送至当前地图随机坐标；这些传送技能只在允许传送的地图才能使用\n\n3.使用盟重回城、比奇回城需要|C:0xda1e00&T:消耗1点飞鞋次数|；使用随机传送需要|C:0xda1e00&T:消耗1张随机传送卷，传送卷不足时消耗1点飞鞋次数|，若飞鞋次数不足，则无法随机传送",
},
[7] = {
	id = 7,
	ruleContent = "1.开服第2天且角色5转开启内功系统，提升内功等级除基础属性外还会增加生命回复和药品回复率\n\n2.提升内功需要内功丹，藏经阁活动和跨服战场（开服32天可获得）\n\n3.生命回复为每隔2秒回复增加值，药品回复率为使用瞬回药品(太阳水、强效太阳水、万年雪霜、疗伤药)时额外增加的回复量百分比\n\n4.内功5级可以学习【灵巧】、【血牛】；内功7级可以学习职业基本技能的静之被动；内功11级可以学习职业基本技能的怒之被动；随着内功提升，还可以学习职业高阶技能的静之和怒之被动，以及雷霆一击",
},
[8] = {
	id = 8,
	ruleContent = "1.转生系统等级达到50级开启\n\n2.提升转生等级可以提高角色属性、伤害加倍，战士/法师/道士获得攻魔道时分别增加物攻/魔法/道术\n\n3.等级排行榜、野蛮冲撞、抗拒火环、气功波等判断级别高低时，优先依据转生级别，其次依据角色等级",
},
[9] = {
	id = 9,
	ruleContent = "1.聊天分为附近/私聊/组队/行会/世界多种类型，开启等级分别为60/60/60/60/48，随着特权等级的提升每日世界聊天的次数增加\n\n2.点击聊天框右上方展开按钮，可以扩大聊天框，方便沟通\n\n3.使用快捷键Shift+鼠标左键点击，可以将背包内物品信息快捷发送至聊天内容\n\n4.通过聊天框左侧按钮，可以开启/关闭附近聊天、行会聊天和私聊信息；通过聊天框上方按钮，可以单独查看世界、行会、组队和私聊频道；点击左下角按钮，可以选在在哪个频道发言，默认为附近聊天频道\n\n5.此外，在个人频道还可以查看最近的物品捡取和经验获取记录",
},
[10] = {
	id = 10,
	ruleContent = "1.添加游戏内好友需要申请并获得对方通过\n\n2.成为好友后互相可以更方便地沟通和查看状态",
},
[11] = {
	id = 11,
	ruleContent = "1.本界面显示附近的其他玩家信息\n\n2.你可以通过申请好友、邀请组队等与其他玩家互动",
},
[12] = {
	id = 12,
	ruleContent = "1.设置关注角色无需对方通过验证\n\n2.你可以给关注角色设置单独的名字颜色显示，方便在战场上快速发现对手",
},
[13] = {
	id = 13,
	ruleContent = "1.设置黑名单后你将无法收到对方的私聊信息\n\n2.一旦与对方成为好友，将自动从黑名单删除\n\n3.请谨慎设置黑名单",
},
[14] = {
